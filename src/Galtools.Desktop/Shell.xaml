<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="galtools · 游戏与资源管理" Width="1440" Height="900" MinWidth="1140" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="SidebarSurface" Background="{DynamicResource SidebarBase}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" ClipToBounds="True"><Grid><Grid x:Name="SidebarArt" ClipToBounds="True" IsHitTestVisible="False"><Image x:Name="SidebarBackgroundImage" Stretch="UniformToFill" Opacity="1"><Image.Effect><BlurEffect Radius="3"/></Image.Effect></Image><Border x:Name="SidebarTint" Background="{DynamicResource SidebarOverlay}" Visibility="Collapsed"/><Grid x:Name="SidebarSubjectStage" Height="455" VerticalAlignment="Bottom" ClipToBounds="True"><Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Transparent" Offset="0"/><GradientStop Color="White" Offset="0.21"/><GradientStop Color="White" Offset="1"/></LinearGradientBrush></Grid.OpacityMask><Image x:Name="SidebarSubjectImage" Width="360" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="1"/></Grid></Grid><Grid Margin="22,27,22,22"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource NavCard}" BorderBrush="{DynamicResource NavCardBorder}" BorderThickness="1" CornerRadius="15" Padding="8" Height="55" VerticalAlignment="Top"><StackPanel Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center"><Border Width="37" Height="37" Background="{DynamicResource PrimaryFill}" CornerRadius="12"><Viewbox Margin="8"><Path Data="M 5 7 C 1 6 0 9 0 14 C 0 18 2 19 5 15 L 15 15 C 18 19 20 18 20 14 C 20 9 19 6 15 7 Z M 4 11 L 8 11 M 6 9 L 6 13 M 14 10 L 14 10.5 M 16 12 L 16 12.5" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Border><TextBlock Text="galtools" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource NavCardText}" Margin="10,1,0,0"/></StackPanel></Border>
   <StackPanel Grid.Row="1"><Button x:Name="NavGames" Style="{StaticResource NavButton}" Tag="active"/><Button x:Name="NavResources" Style="{StaticResource NavButton}"/><Border Height="1" Background="{DynamicResource NavCardBorder}" Margin="12,22,12,20"/><Button x:Name="NavSettings" Style="{StaticResource NavButton}"/></StackPanel>
   <StackPanel Grid.Row="2"><Border Background="{DynamicResource SidebarNote}" CornerRadius="14" Padding="15"><StackPanel><TextBlock Text="故事，常伴身旁。" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="整理收藏，珍藏每一段时光" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel></Border></StackPanel>
  </Grid></Grid></Border>
  <Grid Grid.Column="1" Margin="28,23,28,14">
   <Grid x:Name="GamesPage"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="MY COLLECTION" Foreground="{DynamicResource Faint}" FontSize="10"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="属于你的故事" FontSize="26" FontWeight="Bold"/><Border Background="{DynamicResource PinkSoft}" CornerRadius="10" Padding="9,3" Margin="14,6,0,6"><TextBlock x:Name="GameCount" Text="0 部收藏" Foreground="{DynamicResource Pink}" FontSize="11"/></Border></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="ModeFlow" Content="流动展示" Style="{StaticResource SoftButton}" Margin="0,0,7,0"/><Button x:Name="ModeLibrary" Content="管理显示" Margin="0,0,12,0"/><Button x:Name="PauseWall" Content="暂停流动" Style="{StaticResource SoftButton}"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="154"/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions><TextBox x:Name="GameSearch" Tag="搜索游戏名称、标签或路径…" Margin="0,0,12,0"/><ComboBox x:Name="GameCategory" Grid.Column="1" Margin="0,0,10,0"/><ComboBox x:Name="GameSort" Grid.Column="2" Margin="0,0,10,0"/><Button x:Name="AddGame" Grid.Column="3" Style="{StaticResource PrimaryButton}"/></Grid>
    <Grid Grid.Row="2" x:Name="WallViewport" ClipToBounds="True" Background="{DynamicResource WallFill}"><Grid x:Name="FlowColumns" ClipToBounds="True"/><ScrollViewer x:Name="LibraryViewport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><UniformGrid x:Name="LibraryGrid" Columns="5" Margin="5,8,5,14" HorizontalAlignment="Stretch" VerticalAlignment="Top"/></ScrollViewer><Border x:Name="EmptyLibrary" Background="{DynamicResource Surface}" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="收藏的第一段故事" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="添加游戏并绑定启动程序，让这里慢慢热闹起来。" Foreground="{DynamicResource Muted}" Margin="0,12,0,18"/><Button x:Name="EmptyAdd" Content="添加游戏" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Width="130"/></StackPanel></Border></Grid>
    <Grid Grid.Row="3"><TextBlock x:Name="WallHint" Text="点击卡片查看详情  ·  按序蛇形流动 · 首尾循环" FontSize="10" Foreground="{DynamicResource Faint}" VerticalAlignment="Bottom"/><TextBlock Text="YOUR NEXT STORY AWAITS" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="9" Foreground="{DynamicResource Faint}"/></Grid>
   </Grid>
   <Grid x:Name="ResourcesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="55"/><RowDefinition Height="57"/><RowDefinition Height="*"/><RowDefinition Height="66"/><RowDefinition Height="23"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="RESOURCE STUDIO" FontSize="10" Foreground="{DynamicResource Faint}"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="资源工坊" FontSize="26" FontWeight="Bold"/><TextBlock Text="浏览、预览，把喜欢的片段留下。" Foreground="{DynamicResource Muted}" Margin="18,13,0,0" FontSize="12"/></StackPanel></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="134"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="Back" Width="38" Padding="0" Margin="0,0,5,0"/><Button x:Name="Forward" Width="38" Padding="0" Margin="0,0,5,0"/><Button x:Name="Up" Width="38" Padding="0"/></StackPanel><TextBox x:Name="Address" Grid.Column="1" Tag="输入文件夹或封包路径" Margin="0,0,10,0"/><Button x:Name="OpenFolder" Grid.Column="2" Margin="0,0,10,0"/><ComboBox x:Name="Scheme" Grid.Column="3" IsEditable="True" IsTextSearchEnabled="True" ToolTip="解密方案；选择后点击重新打开"/></Grid>
    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="136"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions><TextBox x:Name="FileSearch" Tag="搜索当前目录中的文件名…" Margin="0,0,10,0"/><ComboBox x:Name="FileType" Grid.Column="1" Margin="0,0,10,0"/><ComboBox x:Name="FileSort" Grid.Column="2" Margin="0,0,10,0"/><Button x:Name="Reopen" Grid.Column="3" Content="按方案重开"/></Grid>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="170" MinWidth="130"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="290"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300" MinWidth="250"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="11,14"><DockPanel><TextBlock Text="资源目录" FontWeight="SemiBold" Margin="6,0,0,12" DockPanel.Dock="Top"/><TreeView x:Name="Directories"/></DockPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,10"><DockPanel><Grid DockPanel.Dock="Top" Height="39" Margin="5,0,5,8"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="LocationName" Text="文件" FontWeight="SemiBold"/><TextBlock x:Name="FileCount" Foreground="{DynamicResource Muted}" FontSize="11" Margin="12,2,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ListMode" Width="34" MinHeight="30" Padding="7" Margin="0,0,5,0"/><Button x:Name="GridMode" Width="34" MinHeight="30" Padding="7"/></StackPanel></Grid>
      <StackPanel x:Name="TilePager" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,8,0,0"><Button x:Name="PreviousTiles" Content="上一页" MinHeight="30" Padding="9,5"/><TextBlock x:Name="TilePageLabel" Text="1 / 1" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource Muted}"/><Button x:Name="NextTiles" Content="下一页" MinHeight="30" Padding="9,5"/></StackPanel><Grid><DataGrid x:Name="Files"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="68"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="84"/></DataGrid.Columns></DataGrid><ListBox x:Name="Tiles" Visibility="Collapsed" BorderThickness="0" Background="{DynamicResource CardSurface}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="144" Margin="7"><Border Height="96" CornerRadius="9" Background="{DynamicResource SoftFill}" ClipToBounds="True"><Grid><TextBlock Text="{Binding Type}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="15"/><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,8,0,4"/><TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
     </DockPanel></Border>
     <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel><Grid Height="31"><TextBlock Text="预览" FontWeight="SemiBold"/><Button x:Name="ExpandPreview" HorizontalAlignment="Right" Width="27" Height="26" MinHeight="0" Padding="5" BorderThickness="0"/></Grid><Border Height="202" Background="{DynamicResource SoftFill}" CornerRadius="12" Margin="0,6,0,0"><Grid><TextBlock x:Name="PreviewEmpty" Text="选择一个文件" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border><TextBlock x:Name="PreviewName" Text="文件详情" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,17,0,10"/><Border Background="{DynamicResource SoftBlue}" CornerRadius="8" Padding="9,5" HorizontalAlignment="Left"><TextBlock x:Name="PreviewBadge" Text="尚未选择" Foreground="{DynamicResource Blue}" FontSize="11"/></Border><Border Height="1" Background="{DynamicResource Line}" Margin="0,20,0,16"/><TextBlock Text="文件信息" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="PreviewInfo" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="25"/><TextBlock x:Name="PreviewStatus" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,17,0,0" LineHeight="19"/><Button x:Name="PlayAudio" Content="播放音频" Visibility="Collapsed" Margin="0,14,0,0" Style="{StaticResource PinkButton}"/></StackPanel></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="10,6"><DockPanel><Button x:Name="ExportAll" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/><Button x:Name="CancelExport" Content="取消" DockPanel.Dock="Right" Visibility="Collapsed"/><WrapPanel><Button x:Name="SaveRaw" Margin="0,0,7,0"/><Button x:Name="SavePng" Margin="0,0,7,0"/><Button x:Name="SaveWav" Margin="0,0,7,0"/><Button x:Name="SaveMp3"/></WrapPanel></DockPanel></Border>
    <TextBlock x:Name="Status" Grid.Row="5" FontSize="10" Foreground="{DynamicResource Faint}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
   </Grid>
   <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="PERSONALIZE YOUR SPACE" Foreground="{DynamicResource Faint}" FontSize="10"/><TextBlock Text="设置" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Width="760" HorizontalAlignment="Left"><Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,18"><StackPanel><TextBlock Text="外观主题" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="选择明亮或夜间配色，切换后立即生效。" Foreground="{DynamicResource Muted}" Margin="0,7,0,20"/><StackPanel Orientation="Horizontal"><Button x:Name="LightTheme" Content="白天模式" Width="134" Height="46" Margin="0,0,12,0"/><Button x:Name="DarkTheme" Content="黑夜模式" Width="134" Height="46"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}" Padding="24"><StackPanel><TextBlock Text="左栏背景" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="添加多张图片作为模糊背景；每 5 秒轮换一张。图片保存在本机数据目录。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,18"/><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button x:Name="AddSidebarImages" Style="{StaticResource PrimaryButton}" Content="添加图片" Margin="0,0,10,0"/><Button x:Name="RemoveSidebarImage" Content="移除选中" Margin="0,0,10,0"/><Button x:Name="ClearSidebarImages" Content="恢复默认背景"/></StackPanel><TextBlock x:Name="SidebarImageCount" Text="正在使用默认背景" Foreground="{DynamicResource Muted}" Margin="0,0,0,9"/><ListBox x:Name="SidebarImages" MinHeight="80" MaxHeight="360" Background="{DynamicResource CardSurface}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Height="56" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SoftFill}"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="14,8,0,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></StackPanel></ScrollViewer></Grid>
   <Border x:Name="ModalOverlay" Background="#66414F6A" Visibility="Collapsed" Margin="-28,-23,-28,-14" CornerRadius="0"><Border x:Name="ModalCard" Width="720" MaxHeight="800" Background="{DynamicResource CardSurface}" CornerRadius="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><Border.Effect><DropShadowEffect Color="#293957" BlurRadius="35" ShadowDepth="10" Opacity="0.18"/></Border.Effect><DockPanel Margin="24"><Grid DockPanel.Dock="Top" Margin="0,0,0,17"><TextBlock x:Name="ModalTitle" Text="游戏详情" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseModal" HorizontalAlignment="Right" Width="32" MinHeight="30" Padding="7" BorderThickness="0"/></Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ModalBody"/></ScrollViewer></DockPanel></Border></Border>
  </Grid>
 </Grid>
</Window>
