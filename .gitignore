# Local game library and user data (may contain private paths)
/data/

# Generated portable packages and download/build caches
/release/
/.build-tools/
/.analysis/
/artifacts/
/logs/
/tools/.downloads/
/vendor/GARbro-Mod/packages/
/vendor/GARbro-Mod/bin/
/vendor/GARbro-Mod/**/obj/

# IDE and compiler scratch files
/.vs/
/.vscode/
/.idea/
*.user
*.suo
*.sln.docstates
*.cache
**/bin/
**/obj/
*.log
*.tmp
.env
.env.*
!.env.example

# Python test caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Local test programs and interrupted exports
/UiSmoke.exe
/WpfSmoke.exe
/WpfSmoke.exe.config
/galtools-fuyin-smoke.exe
/tests/*.exe
/tests/*.exe.config
/runtime/garbro-mod/Galtools.FormatData.exe
/runtime/garbro-mod/Galtools.FormatData.pdb
*.galtools-partial
*.partial

# Keep galtools.exe, runtime/garbro-mod and Formats.dat tracked:
# a Windows clone can run the app without external unpacking tools.
# Keep source, scripts, docs, assets, and deliberately bundled tools tracked.
